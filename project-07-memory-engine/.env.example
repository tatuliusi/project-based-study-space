OPENAI_API_KEY=sk-...

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=semantic_memories

POSTGRES_DSN=postgresql+asyncpg://memory:memory@localhost:5432/memoryengine

# APScheduler nightly consolidation (UTC)
CONSOLIDATION_CRON=0 2 * * *

# Memory ranking
SEMANTIC_SIMILARITY_WEIGHT=0.5
RECENCY_WEIGHT=0.3
IMPORTANCE_WEIGHT=0.2
RECENCY_HALF_LIFE_DAYS=7
TOP_K_MEMORIES=5
